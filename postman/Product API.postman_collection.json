    {
      "name": "2 - Recherche, filtrage, pagination, tri",
      "item": [
        {
          "name": "Recherche : filtres + tri + pagination",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/products/search?name=a&minPrice=10&sort=price&limit=2&offset=0"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Statut 200', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test('2 résultats au plus', () => pm.expect(r.length).to.be.at.most(2));",
                  "pm.test('Trié par prix croissant', () => { for (let i = 1; i < r.length; i++) pm.expect(Number(r[i].price)).to.be.at.least(Number(r[i-1].price)); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Recherche : par catégorie",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/products/search?categoryId=1"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Statut 200', () => pm.response.to.have.status(200));",
                  "pm.test('Tous en catégorie 1', () => pm.response.json().forEach(p => pm.expect(p.category_id).to.eql(1)));"
                ]
              }
            }
          ]
        },
        {
          "name": "Recherche : page 2 (limit=1, offset=1)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/products/search?limit=1&offset=1"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Statut 200', () => pm.response.to.have.status(200));",
                  "pm.test('1 résultat', () => pm.expect(pm.response.json().length).to.eql(1));"
                ]
              }
            }
          ]
        },
        {
          "name": "Recherche : tri malveillant ignoré",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/products/search?sort=price;DROP%20TABLE%20products"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Statut 200', () => pm.response.to.have.status(200));",
                  "pm.test('Liste renvoyée (table intacte)', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3 - Transaction produit + catégorie",
      "item": [
        {
          "name": "Créer produit + catégorie (commit)",
          "request": {
            "method": "POST",
